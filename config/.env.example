# =====================================================
# 飞书群聊消息采集 - 配置模板
# 复制为 config/.env 并填入真实值,切勿提交 .env 到仓库
# 所有项也可通过同名环境变量注入(Docker / 服务器)
# =====================================================

# --- 飞书开放平台 企业自建应用凭据(必填)---
APP_ID=cli_xxxxxxxxxxxxxxxx
APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 事件回调参数(必填)---
# 在应用「事件与回调」页面获取
VERIFICATION_TOKEN=xxxxxxxxxxxxxxxx
ENCRYPT_KEY=                    # 如未开启加密,留空

# --- 服务监听 ---
HOST=0.0.0.0
PORT=8008
# 生产环境 worker 数(多进程)
WORKERS=1

# --- 采集过滤(可选)---
# 留空=采集所有有权限的群;否则填一个或多个 chat_id,逗号分隔
ALLOWED_CHAT_IDS=

# --- 数据库(必填)---
# 本地开发:SQLite,零配置
DATABASE_URL=sqlite:///./data/messages.db
# 生产部署:PostgreSQL(与 docker-compose 配套)
# DATABASE_URL=postgresql+psycopg://feishu:feishu_pass@db:5432/feishu_messages

# --- LLM 主题分类(OpenAI 兼容接口,可选)---
# 留空 LLM_API_KEY 即禁用主题分类,消息仍正常入库(只是不归类)
# 兼容任意提供 /chat/completions 的服务(OpenAI / 企业 model 网关 / vLLM ...)
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=30

# --- 日志(可选)---
LOG_LEVEL=INFO
# 留空=仅控制台; 填路径则同时写入滚动文件
LOG_FILE=
