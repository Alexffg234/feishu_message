[Unit]
Description=Feishu Group Message Collector (feishu_group_message)
After=network.target

[Service]
Type=simple
# 项目部署目录(根据实际路径修改)
WorkingDirectory=/opt/feishu_group_message
# 使用 gunicorn 多 worker 运行 FastAPI
# 多 worker 协调说明(H2):
# - 主题分类、同主题归并、登录限流均已 DB 化互斥(跨 worker 正确),
#   可放心使用 --workers 2~4 提高吞吐。
# - 事件队列每 worker 独立 FIFO;跨 worker 不保证同一 chat 的事件严格有序。
#   解析已做容错(message_id 唯一索引幂等 + 回复消息用事件 root_id 兜底锚组),
#   仅「同人连发轮次合并」的归组质量在乱序时可能略有偏差(无损,不丢数据)。
#   如需严格按 chat 保序,改 --workers 1 或 --worker-class gthread(单进程多线程)。
ExecStart=/opt/feishu_group_message/.venv/bin/gunicorn app.main:app \
    --bind 127.0.0.1:8008 \
    --workers 2 \
    --worker-class uvicorn.workers.UvicornWorker \
    --timeout 60 \
    --graceful-timeout 60 \
    --access-logfile - \
    --error-logfile -

# 环境变量(除 .env 外也可在此注入)
# Environment=DATABASE_URL=mysql+pymysql://root:YOUR_DB_PASSWORD@YOUR_DB_HOST:3306/feishu_message?charset=utf8mb4

# 安全与资源
Restart=always
RestartSec=5
# 默认以 root 运行(避免系统缺少专用用户导致启动失败)
# 如需专用低权限用户,可改为 User=feishu / Group=feishu 并确保目录属主一致
#User=www-data
#Group=www-data
UMask=0027

# 简单沙箱加固
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
