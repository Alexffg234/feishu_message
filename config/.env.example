# =====================================================
# 飞书群聊消息采集 - 配置模板
# 复制为 config/.env 并填入真实值,切勿提交 .env 到仓库
# 所有项也可通过同名环境变量注入(Docker / 服务器)
# =====================================================

# --- 飞书开放平台 企业自建应用凭据(必填)---
APP_ID=cli_xxxxxxxxxxxxxxxx
APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 事件回调参数(必填)---
# 在应用「事件与回调」页面获取
VERIFICATION_TOKEN=xxxxxxxxxxxxxxxx
ENCRYPT_KEY=                    # 如未开启加密,留空

# --- 服务监听 ---
HOST=0.0.0.0
PORT=8008
# 生产环境 worker 数(多进程)
WORKERS=1

# --- 采集过滤(可选)---
# 留空=采集所有有权限的群;否则填一个或多个 chat_id,逗号分隔
ALLOWED_CHAT_IDS=

# --- 数据库(必填)---
# 本地开发:SQLite,零配置
DATABASE_URL=sqlite:///./data/messages.db
# 生产部署:PostgreSQL(与 docker-compose 配套)
# DATABASE_URL=postgresql+psycopg://feishu:feishu_pass@db:5432/feishu_messages

# --- 轮次合并(同一人连发多条,可选)---
# 同一发送者间隔小于该秒数的独立消息合并进同一消息块;0=禁用
# 5 分钟覆盖「先甩截图、随后打字提问」的常见节奏;中间有其他人插话则不并
TURN_MERGE_SECONDS=300

# --- 同主题归组(可选)---
# LLM 打完标签后,同群内相同 topic 的回复链组自动归并到最早组;
# false=只打标签不归并
TOPIC_MERGE_ENABLED=true

# --- 会话缝合(同一案例续聊自动合并,可选)---
# 后台每 N 分钟让 LLM 判定同群相邻会话是否同一问题处理生命周期,是则合并
# (标准标签只归类不合并,同案例后续会话靠它自动缝合;续聊合并不画横杠);
# false 或间隔设 0 = 禁用后台调度(仅手动脚本 scripts/stitch_conversations.py)
CONV_STITCH_ENABLED=true
CONV_STITCH_INTERVAL_MINUTES=30

# --- 主题 AI 总结(后台定时全量预生成,可选)---
# 每 N 分钟对指纹(消息数/最大消息 id)变化的 topic 重新生成 AI 分析;0=禁用
TOPIC_SUMMARY_INTERVAL_MINUTES=10

# --- LLM 主题分类(OpenAI 兼容接口,可选)---
# 留空 LLM_API_KEY 即禁用主题分类,消息仍正常入库(只是不归类)
# 兼容任意提供 /chat/completions 的服务(OpenAI / 企业 model 网关 / vLLM ...)
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=30

# --- 图片资源(可选)---
# 收到图片消息时,自动下载飞书图片并上传到七牛,生成可展示 URL。
# 未配置则图片消息仅保留 image_key(不展示),优雅降级不报错。
# QINIU_DOMAIN 为七牛 CDN 访问域名,不带尾斜杠,如 https://cdn.example.com
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=
# 是否启用图片下载落盘(默认 true;false 则完全不做图片资源)
IMAGE_DOWNLOAD_ENABLED=true

# --- 访问控制(登录注册,可选)---
# true = 除登录页/认证接口/健康检查/飞书事件回调外,全部要求登录
# AUTH_ENABLED=false 仅供本地调试,生产务必保持 true
AUTH_ENABLED=true
# 是否开放自助注册;false 时用 scripts/create_user.py 开号
# (库里尚无账号时注册始终开放,否则无法创建首个管理员)
ALLOW_PUBLIC_REGISTER=true
# 登录态有效期(小时)
SESSION_TTL_HOURS=12
# 会话 cookie 签名密钥;留空则自动生成并持久化到 data/.session_secret
# 多实例部署必须显式配置成同一个值,否则会互相踢下线
SESSION_SECRET=
# 站点为 https 时必须置 true,否则浏览器不会回传 cookie
COOKIE_SECURE=false

# --- 日志(可选)---
LOG_LEVEL=INFO
# 留空=仅控制台; 填路径则同时写入滚动文件
LOG_FILE=
